#!/usr/bin/env bash
set -Eeuo pipefail

P=${1:?profile}
N=${2:?replicate}

case ${P} in
standard|low_rate|high_concurrency|bursty|long_session|perturbed_uplink|perturbed_fullpath) ;;
*) echo INVALID_PROFILE=${P}; exit 2 ;;
esac

ROOT=/home/etip/Tunnel/proxytraffic
source ${ROOT}/.venv/bin/activate

LROOT=/home/etip/datasets/staging/trojan/tcp_tls/formal_v1
RROOT=/home/dataset-assist-0/duwenbiao/Tunnel/proxydata/trojan/tcp_tls/formal_v1
REMOTE=proxydata-server

IDX=$(printf '%02d' ${N})

EXP=${ROOT}/encrypted_traffic_platform/experiments/trojan/tcp_tls/${P}.yaml
WORK=${ROOT}/encrypted_traffic_platform/proxy_generator/trojan/tcp_tls/${P}.yaml
VAL=${ROOT}/encrypted_traffic_platform/trojan/validate_sample.py

B=${LROOT}/${P}/r${IDX}
RB=${RROOT}/${P}/r${IDX}
MARK=${RB}/BATCH_COMPLETE

cleanup() {
    set +e
    /home/etip/bin/trojan-fullpath-netem clear >/dev/null 2>&1 || true
    sudo -n /usr/local/sbin/etip-trojan-netem clear >/dev/null 2>&1 || true
    ${ROOT}/encrypted_traffic_platform/deployment/trojan/stop_client.sh >/dev/null 2>&1 || true
}

trap cleanup EXIT

if ssh ${REMOTE} "test -f '${MARK}'"; then
    echo FORMAL_SKIP_COMPLETE=${P}_r${IDX}
    exit 0
fi

git -C ${ROOT} diff --quiet
git -C ${ROOT} diff --cached --quiet

nc -z -w 5 192.168.100.20 20003

cleanup

rm -rf ${B}
mkdir -p ${B}

echo FORMAL_START=${P}_r${IDX}

PYTHONDONTWRITEBYTECODE=1 \
python -B \
  ${ROOT}/encrypted_traffic_platform/scripts/run_enriched_experiment.py \
  --config ${EXP} \
  --dataset-root ${B}

SAMPLE=$(
  find ${B} \
    -type f \
    -name session.json \
    -printf '%T@ %h\n' \
  | sort -n \
  | tail -n 1 \
  | cut -d' ' -f2-
)

test -n "${SAMPLE}"

python ${VAL} ${SAMPLE}

{
    echo profile=${P}
    echo replicate=${IDX}
    echo git_head=$(git -C ${ROOT} rev-parse HEAD)
    echo collected_utc=$(date -u +%Y%m%dT%H%M%SZ)
    echo xray_sha256=$(sha256sum /usr/local/bin/xray | awk '{print $1}')
    echo experiment_sha256=$(sha256sum ${EXP} | awk '{print $1}')
    echo workload_sha256=$(sha256sum ${WORK} | awk '{print $1}')
    echo validator_sha256=$(sha256sum ${VAL} | awk '{print $1}')
    echo client_config_sha256=$(sha256sum ${HOME}/.config/proxytraffic/trojan/client.json | awk '{print $1}')
} > ${B}/batch_metadata.txt

(
    cd ${B}

    find . \
      -type f \
      ! -name SHA256SUMS.txt \
      -print0 \
    | sort -z \
    | xargs -0 sha256sum \
    > SHA256SUMS.txt

    sha256sum -c SHA256SUMS.txt >/dev/null
)

ssh ${REMOTE} "rm -rf '${RB}'; mkdir -p '${RB}'"

SYNC=0

for TRY in 1 2 3
do
    if rsync \
      -a \
      --partial \
      --append-verify \
      --timeout=300 \
      --bwlimit=8192 \
      ${B}/ \
      ${REMOTE}:${RB}/
    then
        SYNC=1
        break
    fi

    sleep 5
done

test ${SYNC} -eq 1

ssh ${REMOTE} \
  "cd '${RB}' && sha256sum -c SHA256SUMS.txt >/dev/null"

COUNT=$(
  ssh ${REMOTE} \
    "find '${RB}' -type f -name session.json | wc -l"
)

test ${COUNT} -eq 1

ssh ${REMOTE} \
  "date -u +%Y%m%dT%H%M%SZ > '${MARK}'"

mkdir -p ${LROOT}

printf '%s\t%s\t%s\t%s\n' \
  ${P} \
  ${IDX} \
  $(git -C ${ROOT} rev-parse HEAD) \
  ${RB} \
  >> ${LROOT}/formal_ledger.tsv

cleanup
trap - EXIT

rm -rf ${B}

echo FORMAL_BATCH_PASS=${P}_r${IDX}
