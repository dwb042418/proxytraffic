#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=/home/etip/Tunnel/proxytraffic
PLATFORM=${ROOT}/encrypted_traffic_platform

RUNNER=${PLATFORM}/scripts/run_enriched_experiment.py
VALIDATOR=${PLATFORM}/dataset/validator.py
SS_VALIDATOR=${PLATFORM}/shadowsocks/validate_sample.py
SYNC_TOOL=/home/etip/bin/proxydata-sync

CONFIG=${PLATFORM}/experiments/shadowsocks/aes_256_gcm/standard.yaml

TARGET=${1:-10}

LOCAL_ROOT=/home/etip/datasets/staging/shadowsocks/aes_256_gcm/validation/stability_v2/batches

REMOTE_BASE=/home/dataset-assist-0/duwenbiao/Tunnel/proxydata/shadowsocks/aes_256_gcm/validation/stability_v2/batches

REMOTE_STAGE=validation/stability_v2/batches

if ! [[ ${TARGET} =~ ^[1-9][0-9]*$ ]]
then
    echo ERROR_INVALID_TARGET
    exit 2
fi

cd ${ROOT}

source .venv/bin/activate

mkdir -p ${LOCAL_ROOT}

echo '===== PRECHECK ====='

test -f ${CONFIG}
test -x ${RUNNER}
test -f ${VALIDATOR}
test -x ${SS_VALIDATOR}
test -x ${SYNC_TOOL}

nc -z -w 3 \
  192.168.100.20 \
  20002

ssh \
  -o BatchMode=yes \
  -o ConnectTimeout=10 \
  proxydata-server \
  'echo REMOTE_STORAGE_OK'

remote_count() {
    ssh \
      -o BatchMode=yes \
      -o ConnectTimeout=15 \
      proxydata-server \
      'find '${REMOTE_BASE}' -type f -name session.json 2>/dev/null | wc -l'
}

while true
do
    EXISTING=$(remote_count)

    echo REMOTE_PASS_COUNT=${EXISTING}
    echo TARGET=${TARGET}

    if [ ${EXISTING} -gt ${TARGET} ]
    then
        echo ERROR_REMOTE_COUNT_EXCEEDS_TARGET
        exit 1
    fi

    if [ ${EXISTING} -eq ${TARGET} ]
    then
        echo SHADOWSOCKS_STABILITY_TARGET_REACHED
        exit 0
    fi

    INDEX=$((EXISTING + 1))

    BATCH_ID=$(
        printf 'stability_%02d_%s_%04x' \
          ${INDEX} \
          $(date -u +%Y%m%dT%H%M%SZ) \
          ${RANDOM}
    )

    LOCAL_BATCH=${LOCAL_ROOT}/${BATCH_ID}
    REMOTE_BATCH=${REMOTE_STAGE}/${BATCH_ID}

    mkdir -p ${LOCAL_BATCH}

    echo
    echo '===== NEW SAMPLE ====='
    echo INDEX=${INDEX}
    echo BATCH_ID=${BATCH_ID}
    echo LOCAL_BATCH=${LOCAL_BATCH}

    set +e

    python \
      ${RUNNER} \
      --config ${CONFIG} \
      --dataset-root ${LOCAL_BATCH}

    RUN_RC=$?

    set -e

    if [ ${RUN_RC} -ne 0 ]
    then
        echo SAMPLE_COLLECTION_FAILED
        echo LOCAL_BATCH_PRESERVED=${LOCAL_BATCH}
        exit 1
    fi

    echo '===== GENERIC VALIDATION ====='

    python \
      ${VALIDATOR} \
      ${LOCAL_BATCH}

    SAMPLE=$(
        find ${LOCAL_BATCH} \
          -type f \
          -name session.json \
          -printf '%h\n' \
        | head -n 1
    )

    test -n ${SAMPLE}

    echo SAMPLE=${SAMPLE}

    echo '===== SHADOWSOCKS VALIDATION ====='

    python \
      ${SS_VALIDATOR} \
      ${SAMPLE}

    echo '===== BATCH METADATA ====='

    cat > ${LOCAL_BATCH}/batch_metadata.json <<EOF
{
  "batch_id": "${BATCH_ID}",
  "proxy_type": "shadowsocks",
  "protocol": "aes_256_gcm",
  "stage": "validation_stability_v2",
  "sample_index": ${INDEX},
  "sample_count": 1,
  "created_utc": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

    echo '===== REMOTE SYNC ====='

    ${SYNC_TOOL} \
      ${LOCAL_BATCH} \
      shadowsocks \
      aes_256_gcm \
      ${REMOTE_BATCH} \
      --delete-local

    AFTER=$(remote_count)

    echo REMOTE_PASS_COUNT_AFTER=${AFTER}

    if [ ${AFTER} -ne ${INDEX} ]
    then
        echo ERROR_REMOTE_COUNT_MISMATCH
        exit 1
    fi

    echo SAMPLE_COMPLETE=${INDEX}/${TARGET}
done
