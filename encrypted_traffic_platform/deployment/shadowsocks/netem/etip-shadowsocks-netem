#!/usr/bin/env bash
set -Eeuo pipefail

IFACE=ens37
SERVER_IP=192.168.100.20
SERVER_PORT=20002

case "${1:-}" in
    apply)
        tc qdisc replace dev "${IFACE}" root handle 1: prio bands 3
        tc qdisc replace \
          dev "${IFACE}" \
          parent 1:3 \
          handle 30: \
          netem \
          delay 40ms 10ms \
          loss 0.2% \
          rate 8mbit

        tc filter replace \
          dev "${IFACE}" \
          protocol ip \
          parent 1:0 \
          prio 30 \
          u32 \
          match ip dst "${SERVER_IP}/32" \
          match ip protocol 6 0xff \
          match ip dport "${SERVER_PORT}" 0xffff \
          flowid 1:3

        tc -s qdisc show dev "${IFACE}"
        ;;

    clear)
        tc qdisc replace dev "${IFACE}" root fq_codel
        ;;

    status)
        tc -s qdisc show dev "${IFACE}"
        tc filter show dev "${IFACE}" parent 1:0 || true
        ;;

    *)
        echo 'usage: etip-shadowsocks-netem apply|clear|status' >&2
        exit 2
        ;;
esac
